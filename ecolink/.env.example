# Supabase Auth, database, and storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SERVICE_ROLE_KEY="replace_me"

# Clerk authentication (Clerk is configured as Supabase Third-Party Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_DOMAIN="example.clerk.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Legacy Prisma commands still require this while old repository modules exist.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Gemini recyclability analyzer (server-only)
GEMINI_API_KEY="replace_me"
AI_SCANNER_MODEL="gemini-3.1-flash-lite"
AI_SCANNER_MAX_UPLOAD_MB="10"

# Explicit local demo mode. Disable this for production Clerk authentication.
NEXT_PUBLIC_ECOLINK_DEMO_MODE="true"
