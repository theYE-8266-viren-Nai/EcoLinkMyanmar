# Supabase Auth, database, and storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SECRET_KEY="sb_secret_replace_me"
# Legacy fallback for projects that have not migrated to secret keys:
# SUPABASE_SERVICE_ROLE_KEY="replace_me"

# Legacy Prisma commands still require this while old repository modules exist.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# OpenRouter AI provider (server-only)
OPENROUTER_API_KEY="replace_me"
AI_SCANNER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
AI_SCANNER_MAX_UPLOAD_MB="10"

# Explicit local demo mode. Disable this for production Supabase authentication.
NEXT_PUBLIC_ECOLINK_DEMO_MODE="true"

# Public Mapbox browser token and EcoLink's Mapbox Studio style.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.replace_me"
NEXT_PUBLIC_MAPBOX_STYLE_URL="mapbox://styles/happer64bit/clnpqzscu00dj01qqhgrkhawy"
