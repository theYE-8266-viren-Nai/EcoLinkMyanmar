          "address": {
            "type": "string",
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "default": "DRAFT"
          }
        },
        "required": [
          "organizationId",
          "title",
          "slug",
          "description",
          "startsAt",
          "status"
        ]
      },
      "CreateEnvironmentReportRequestBodySchema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
