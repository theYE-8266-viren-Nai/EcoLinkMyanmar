                "$ref": "#/components/schemas/uuidSchema"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "body": {
            "type": "string",
            "minLength": 20
          },
          "coverImageUrl": {
            "type": "string",
            "format": "uri"
          },
          "contentStatus": {
            "type": "string",
            "default": "DRAFT"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "authorId",
          "title",
          "slug",
          "summary",
          "body",
          "contentStatus"
        ]
      },
      "environmentReportRatingSchema": {
        "type": "object",
        "properties": {
          "dirtinessScore": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "dirtinessScore",
          "confidence",
          "reasoning",
          "warnings"
        ]
      },
      "EnvironmentReportResponseSchema": {
        "type": "object",
        "properties": {
          "dirtinessScore": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
