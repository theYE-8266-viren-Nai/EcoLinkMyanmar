          "AI_AUTHENTICATION_FAILED",
          "AI_CREDITS_EXHAUSTED",
          "AI_INPUT_REJECTED",
          "AI_INVALID_RESPONSE",
          "AI_MODEL_UNAVAILABLE",
          "AI_PROVIDER_FAILED",
          "AI_PROVIDER_RATE_LIMITED",
          "AI_PROVIDER_UNREACHABLE",
          "AI_REQUEST_TIMEOUT"
        ]
      },
      "AiProviderErrorResponseSchema": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/AiProviderErrorCodeSchema"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code",
          "reason"
        ]
      },
      "AiScanDetectionResponseSchema": {
        "type": "object",
        "properties": {
          "materialLabel": {
            "type": "string"
          },
          "materialSlug": {
            "type": [
              "string",
