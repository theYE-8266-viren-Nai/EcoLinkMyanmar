          },
          "itemType": {
            "type": "string"
          },
          "estimatedCount": {
            "$ref": "#/components/schemas/finiteNumber"
          },
          "estimatedWeightKg": {
            "$ref": "#/components/schemas/finiteNumber"
          },
          "confidence": {
            "$ref": "#/components/schemas/finiteNumber"
          },
          "reasoning": {
            "type": "string"
          }
        },
        "required": [
          "materialLabel",
          "materialSlug",
          "itemType",
          "estimatedCount",
          "estimatedWeightKg",
          "confidence",
          "reasoning"
        ]
      },
      "aiScanProviderOutputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "primaryMaterialLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "estimatedBottleCount": {
                "$ref": "#/components/schemas/finiteNumber"
              },
              "estimatedTotalWeightKg": {
                "$ref": "#/components/schemas/finiteNumber"
              },
              "confidence": {
                "$ref": "#/components/schemas/finiteNumber"
              }
            },
            "required": [
              "primaryMaterialLabel",
              "estimatedBottleCount",
              "estimatedTotalWeightKg",
              "confidence"
            ]
          },
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "materialLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "itemType": {
                  "type": "string",
                  "minLength": 1
                },
                "estimatedCount": {
                  "$ref": "#/components/schemas/finiteNumber"
                },
                "estimatedWeightKg": {
                  "$ref": "#/components/schemas/finiteNumber"
                },
                "confidence": {
                  "$ref": "#/components/schemas/finiteNumber"
                },
                "reasoning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "materialLabel",
                "itemType",
                "estimatedCount",
                "estimatedWeightKg",
                "confidence",
                "reasoning"
              ]
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "summary",
          "detections",
          "warnings"
        ]
      },
      "AiScanRequestBodySchema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "x-contentMediaTypes": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "description": "JPEG, PNG, or WebP image up to the configured upload limit.",
            "contentMediaType": "application/octet-stream"
          }
        },
        "required": [
          "image"
        ]
      },
      "AiScanResponseSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/AiScanSummaryResponseSchema"
          },
          "detections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiScanDetectionResponseSchema"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary",
          "detections",
          "warnings"
        ]
      },
      "AiScanSummaryResponseSchema": {
        "type": "object",
        "properties": {
          "primaryMaterialLabel": {
            "type": [
