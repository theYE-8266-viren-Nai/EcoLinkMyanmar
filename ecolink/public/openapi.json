            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "image"
        ],
        "additionalProperties": false
      },
      "createEnvironmentReportSubmissionSchema": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "decimalStringSchema": {
