{
  "openapi": "3.1.0",
  "info": {
    "title": "EcoLink API",
    "version": "1.0.0",
    "description": "Public EcoLink APIs for AI recyclable-item and environment image analysis."
  },
  "paths": {
    "/api/ai/scans": {
      "post": {
        "operationId": "post-ai-scans",
        "summary": "Analyze a recyclable-items image",
        "description": "Accepts exactly one JPEG, PNG, or WebP image up to the configured upload limit. The image and result are not persisted.",
        "tags": [
          "AI Scanner"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AiScanRequestBodySchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized image analysis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiScanResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid multipart request or image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "500": {
            "description": "Internal processing failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "502": {
            "description": "Vision provider failure or unusable provider output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiProviderErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/environment-reports": {
      "post": {
        "operationId": "post-environment-reports",
        "summary": "Rate an environment image",
        "description": "Accepts one image and an optional note. AI returns a 1–10 dirtiness rating. Nothing is saved.",
        "tags": [
          "Environment Reports"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateEnvironmentReportRequestBodySchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The AI environment rating.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentReportResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid multipart request or image or note.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "500": {
            "description": "Internal processing failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "502": {
            "description": "AI dirtiness rating failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiProviderErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AI Scanner"
    },
    {
      "name": "Environment Reports"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "Current EcoLink deployment"
    }
  ],
  "components": {
    "schemas": {
      "addressSchema": {
        "type": "object",
        "properties": {
          "userProfileId": {
            "$ref": "#/components/schemas/uuidSchema"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "line1": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "line2": {
            "type": "string",
            "maxLength": 160
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "township": {
            "type": "string",
            "maxLength": 80
          },
          "region": {
            "type": "string",
            "maxLength": 80
          },
          "postalCode": {
            "type": "string",
            "maxLength": 20
          },
          "latitude": {
            "allOf": [
              {
                "$ref": "#/components/schemas/decimalStringSchema"
              }
            ]
          },
          "longitude": {
            "allOf": [
              {
                "$ref": "#/components/schemas/decimalStringSchema"
              }
            ]
          },
          "instructions": {
            "type": "string",
            "maxLength": 500
